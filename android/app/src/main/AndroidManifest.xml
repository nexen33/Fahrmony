<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Queries: API 30+ 跨应用包名发现与 MediaSessionService 绑定 -->
    <queries>
        <!-- IM 应用 -->
        <package android:name="com.tencent.mm" />
        <package android:name="com.ss.android.lark" />
        <package android:name="com.alibaba.android.rimet" />
        
        <!-- 媒体应用 -->
        <package android:name="com.tencent.qqmusic" />
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.ximalaya.ting.android" />
        <package android:name="app.podcast.cosmos" />
        <package android:name="kugou.service" />
        <package android:name="cn.kuwo.player" />

        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_car_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_car_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Android Auto 车载应用功能描述 (声明纯净 Media 媒体服务) -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 模块 A: IM 通知捕获服务 (:car 独立进程隔离) -->
        <service
            android:name=".nativebridge.FahrmonyNotificationListener"
            android:process=":car"
            android:label="Fahrmony 通知桥接服务"
            android:icon="@mipmap/ic_car_launcher"
            android:roundIcon="@mipmap/ic_car_launcher"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 守护与媒体前台服务 (:car 独立进程隔离) -->
        <service
            android:name=".nativebridge.FahrmonyForegroundService"
            android:process=":car"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- 模块 C: Android Auto 原生全屏音频沉浸媒体服务 (MediaBrowserServiceCompat, :car 独立进程隔离) -->
        <service
            android:name=".nativebridge.FahrmonyMediaBrowserService"
            android:process=":car"
            android:icon="@mipmap/ic_car_launcher"
            android:roundIcon="@mipmap/ic_car_launcher"
            android:theme="@style/CarMediaTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Google 官方标准：注册 MediaButtonReceiver，确保硬件按键与系统媒体广播精准路由到 :car 进程 -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:process=":car"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Android Auto 车载 MessagingStyle 动作接收器 (标记已读与语音回复) -->
        <receiver
            android:name=".nativebridge.FahrmonyMessageReceiver"
            android:process=":car"
            android:exported="false">
            <intent-filter>
                <action android:name="com.fahrmony.app.ACTION_MARK_AS_READ" />
                <action android:name="com.fahrmony.app.ACTION_REPLY" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
